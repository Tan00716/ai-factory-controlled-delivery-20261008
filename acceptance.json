{
  "title": "公开合成标签统计 CLI",
  "goal": "修复多文件标签 CLI：读取 JSON 对象 tags 字符串数组，trim 与 toLowerCase，删除空标签、去重、按 JavaScript 字符串默认排序，输出 JSON 对象 tags 和去重后的 count，无换行。非法 JSON、非对象、缺少或非数组 tags、非字符串元素必须 exit 2、stderr INVALID_INPUT 换行、无 stdout。仅授权两个 src 文件。",
  "criteria": [
    "规范化所有字符串标签：trim、toLowerCase 后按 Unicode NFC 规范化，删除空标签，保留内部空格与字符本身；组合字符序列与对应预组合字符视为同一标签。",
    "去重并按 JavaScript 默认字符串排序，输出准确 tags 和 count；空数组返回 tags=[] count=0，无输出换行。",
    "非法 JSON、非对象、缺少或非数组 tags、非字符串元素拒绝：exit 2，stderr INVALID_INPUT 换行，stdout 空；只修改授权两个源文件。"
  ],
  "adapter": {
    "id": "NODE_JSON_CLI_V1",
    "entrypoint": "src/cli.cjs",
    "cases": [
      {
        "key": "normalize",
        "ac": 0,
        "input": "{\"tags\":[\" Blue \",\"blue\",\"RED\"]}",
        "expected": "{\"tags\":[\"blue\",\"red\"],\"count\":2}",
        "exitCode": 0,
        "stderr": ""
      },
      {
        "key": "empty",
        "ac": 1,
        "input": "{\"tags\":[]}",
        "expected": "{\"tags\":[],\"count\":0}",
        "exitCode": 0,
        "stderr": ""
      },
      {
        "key": "drop-empty",
        "ac": 0,
        "input": "{\"tags\":[\"\",\"   \",\"a\"]}",
        "expected": "{\"tags\":[\"a\"],\"count\":1}",
        "exitCode": 0,
        "stderr": ""
      },
      {
        "key": "sort",
        "ac": 1,
        "input": "{\"tags\":[\"z\",\"B\",\"a\"]}",
        "expected": "{\"tags\":[\"a\",\"b\",\"z\"],\"count\":3}",
        "exitCode": 0,
        "stderr": ""
      },
      {
        "key": "dedup",
        "ac": 1,
        "input": "{\"tags\":[\"a\",\"A\",\" a \"]}",
        "expected": "{\"tags\":[\"a\"],\"count\":1}",
        "exitCode": 0,
        "stderr": ""
      },
      {
        "key": "single",
        "ac": 0,
        "input": "{\"tags\":[\" abc \"]}",
        "expected": "{\"tags\":[\"abc\"],\"count\":1}",
        "exitCode": 0,
        "stderr": ""
      },
      {
        "key": "spaces",
        "ac": 0,
        "input": "{\"tags\":[\"  a b  \",\"\\t x \\n\"]}",
        "expected": "{\"tags\":[\"a b\",\"x\"],\"count\":2}",
        "exitCode": 0,
        "stderr": ""
      },
      {
        "key": "unicode",
        "ac": 0,
        "input": "{\"tags\":[\" Ä \",\"ä\",\"中\"]}",
        "expected": "{\"tags\":[\"ä\",\"中\"],\"count\":2}",
        "exitCode": 0,
        "stderr": ""
      },
      {
        "key": "punctuation",
        "ac": 1,
        "input": "{\"tags\":[\"x-y\",\"X-Y\",\"x_y\"]}",
        "expected": "{\"tags\":[\"x-y\",\"x_y\"],\"count\":2}",
        "exitCode": 0,
        "stderr": ""
      },
      {
        "key": "numbers-as-strings",
        "ac": 0,
        "input": "{\"tags\":[\" 12 \",\"12\",\"01\"]}",
        "expected": "{\"tags\":[\"01\",\"12\"],\"count\":2}",
        "exitCode": 0,
        "stderr": ""
      },
      {
        "key": "sorted",
        "ac": 1,
        "input": "{\"tags\":[\"a\",\"b\"]}",
        "expected": "{\"tags\":[\"a\",\"b\"],\"count\":2}",
        "exitCode": 0,
        "stderr": ""
      },
      {
        "key": "malformed",
        "ac": 2,
        "input": "{",
        "expected": "",
        "exitCode": 2,
        "stderr": "INVALID_INPUT\n"
      },
      {
        "key": "blank",
        "ac": 2,
        "input": "",
        "expected": "",
        "exitCode": 2,
        "stderr": "INVALID_INPUT\n"
      },
      {
        "key": "null",
        "ac": 2,
        "input": "null",
        "expected": "",
        "exitCode": 2,
        "stderr": "INVALID_INPUT\n"
      },
      {
        "key": "array",
        "ac": 2,
        "input": "[]",
        "expected": "",
        "exitCode": 2,
        "stderr": "INVALID_INPUT\n"
      },
      {
        "key": "number",
        "ac": 2,
        "input": "3",
        "expected": "",
        "exitCode": 2,
        "stderr": "INVALID_INPUT\n"
      },
      {
        "key": "string",
        "ac": 2,
        "input": "\"a\"",
        "expected": "",
        "exitCode": 2,
        "stderr": "INVALID_INPUT\n"
      },
      {
        "key": "boolean",
        "ac": 2,
        "input": "true",
        "expected": "",
        "exitCode": 2,
        "stderr": "INVALID_INPUT\n"
      },
      {
        "key": "missing",
        "ac": 2,
        "input": "{}",
        "expected": "",
        "exitCode": 2,
        "stderr": "INVALID_INPUT\n"
      },
      {
        "key": "tagsnull",
        "ac": 2,
        "input": "{\"tags\":null}",
        "expected": "",
        "exitCode": 2,
        "stderr": "INVALID_INPUT\n"
      },
      {
        "key": "tagsstring",
        "ac": 2,
        "input": "{\"tags\":\"a\"}",
        "expected": "",
        "exitCode": 2,
        "stderr": "INVALID_INPUT\n"
      },
      {
        "key": "membernumber",
        "ac": 2,
        "input": "{\"tags\":[1]}",
        "expected": "",
        "exitCode": 2,
        "stderr": "INVALID_INPUT\n"
      },
      {
        "key": "membernull",
        "ac": 2,
        "input": "{\"tags\":[null]}",
        "expected": "",
        "exitCode": 2,
        "stderr": "INVALID_INPUT\n"
      },
      {
        "key": "memberobject",
        "ac": 2,
        "input": "{\"tags\":[{}]}",
        "expected": "",
        "exitCode": 2,
        "stderr": "INVALID_INPUT\n"
      },
      {
        "key": "memberarray",
        "ac": 2,
        "input": "{\"tags\":[[]]}",
        "expected": "",
        "exitCode": 2,
        "stderr": "INVALID_INPUT\n"
      },
      {
        "key": "memberboolean",
        "ac": 2,
        "input": "{\"tags\":[true]}",
        "expected": "",
        "exitCode": 2,
        "stderr": "INVALID_INPUT\n"
      },
      {
        "key": "nfc-compose",
        "ac": 0,
        "input": "{\"tags\":[\"Cafe\\u0301\",\"caf\\u00e9\"]}",
        "expected": "{\"tags\":[\"café\"],\"count\":1}",
        "exitCode": 0,
        "stderr": ""
      },
      {
        "key": "nfc-upper",
        "ac": 0,
        "input": "{\"tags\":[\" CAFE\\u0301 \",\"Caf\\u00e9\"]}",
        "expected": "{\"tags\":[\"café\"],\"count\":1}",
        "exitCode": 0,
        "stderr": ""
      },
      {
        "key": "nfc-sort",
        "ac": 1,
        "input": "{\"tags\":[\"e\\u0301\",\"f\",\"e\"]}",
        "expected": "{\"tags\":[\"e\",\"f\",\"é\"],\"count\":3}",
        "exitCode": 0,
        "stderr": ""
      }
    ],
    "testAuthority": "HUMAN_SEALED_ORACLE",
    "actions": [
      "NODE_ENTRYPOINT_STDIN"
    ],
    "nodeVersion": "24.12.0",
    "maxOutputBytes": 16384,
    "commandTimeoutMs": 3000,
    "failureSemantics": "EXACT_BYTES_EXIT_CODE_NO_MODEL_OVERRIDE"
  }
}
